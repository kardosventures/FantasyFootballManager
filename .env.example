APP_ENV=development
APP_TIMEZONE=America/Denver
DATABASE_URL=postgresql+asyncpg://fantasy:fantasy@db:5432/fantasy
SYNC_DATABASE_URL=postgresql+psycopg://fantasy:fantasy@db:5432/fantasy
POSTGRES_DB=fantasy
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=fantasy
SLEEPER_BASE_URL=https://api.sleeper.app/v1
SLEEPER_LEAGUE_ID=1395499060898586624
SLEEPER_OWNER_USER_ID=1398337982238343168
SLEEPER_ROSTER_ID=8
# Optional: set only when rehearsing against a standalone Sleeper mock draft.
SLEEPER_DRAFT_ID=
SLEEPER_LEAGUE_WEB_URL=https://sleeper.com/leagues/1395499060898586624
DRAFT_POLL_SECONDS=2
DRAFT_STATIC_REFRESH_MINUTES=60
# Keep false until `make browser-login` has saved the dedicated session.
DRAFT_AUTO_PICK_ENABLED=false
# Show the expert pick immediately, then release it to Playwright near the end of the clock.
DRAFT_AUTO_SUBMIT_SECONDS_REMAINING=15
# Standalone mocks use their own delay after the pick clock starts; zero submits as soon as Codex decides.
DRAFT_MOCK_AUTO_SUBMIT_DELAY_SECONDS=0
# Set above zero only if a close expert decision should intentionally block automation.
DRAFT_MIN_CONFIDENCE=0
# The expert model makes the normal selection. If Codex fails or times out, the
# roster-aware programmatic engine can make an emergency pick from the same
# verified live allowlist after the backend confirms the board is unchanged.
DRAFT_EXPERT_ENABLED=false
DRAFT_EXPERT_PROVIDER=codex_cli
DRAFT_EXPERT_MODEL=gpt-5.6-terra
DRAFT_EXPERT_REASONING_EFFORT=medium
DRAFT_EXPERT_TIMEOUT_SECONDS=85
DRAFT_EXPERT_EMERGENCY_FALLBACK_ENABLED=true
DRAFT_EXPERT_CANDIDATE_POOL_SIZE=72
DRAFT_EXPERT_WEB_SEARCH_ENABLED=true
OPENAI_API_KEY=
# Optional targeted weekly projection signal. The limited key returns ten players per request.
FANTASYPROS_API_KEY=
FANTASYPROS_BASE_URL=https://api.fantasypros.com/public/v2/json
IN_SEASON_SYNC_ENABLED=true
NFLVERSE_SYNC_HOURS=4
# Completed seasons are stored in a compressed archive and used only by backtests.
NFLVERSE_HISTORY_START_SEASON=2021
# Optional comma-separated prior Sleeper league IDs when previous_league_id is unavailable.
SLEEPER_HISTORICAL_LEAGUE_IDS=
# Free-tier budget: four targeted requests every three hours = at most 32/day.
FANTASYPROS_SYNC_MINUTES=180
FANTASYPROS_DAILY_REQUEST_LIMIT=50
FANTASYPROS_REQUEST_RESERVE=10
FANTASYPROS_REQUESTS_PER_SYNC=4
FANTASYPROS_EMERGENCY_REFRESH_COOLDOWN_MINUTES=15
IN_SEASON_EXPERT_ENABLED=false
IN_SEASON_EXPERT_MINUTES=60
IN_SEASON_EXPERT_TIMEOUT_SECONDS=300
IN_SEASON_LINEUP_ACTIONS_ENABLED=false
IN_SEASON_LINEUP_MIN_CONFIDENCE=0.75
IN_SEASON_LINEUP_SUBMIT_MINUTES_BEFORE_KICKOFF=45
IN_SEASON_LINEUP_EXPIRE_MINUTES_BEFORE_KICKOFF=5
IN_SEASON_ACQUISITION_ACTIONS_ENABLED=false
# When true, unqualified in-season selectors may make one exact attempt and must
# verify afterward; any blocked/failed/ambiguous result is never retried automatically.
IN_SEASON_TRANSACTION_TRUST_THEN_VERIFY=false
# Independently qualify and enable these action families.
# Multiple immediate moves are never queued together. When enabled, only the
# first move is released; a verified roster refresh and fresh expert plan are
# required before another move can be scheduled.
IN_SEASON_SEQUENTIAL_FREE_AGENT_ACTIONS_ENABLED=false
IN_SEASON_MULTI_CLAIM_ACTIONS_ENABLED=false
IN_SEASON_PENDING_WAIVER_ACTIONS_ENABLED=false
IN_SEASON_IR_ACTIONS_ENABLED=false
IN_SEASON_TRADE_ACTIONS_ENABLED=false
IN_SEASON_TRADE_MIN_CONFIDENCE=0.92
IN_SEASON_TRADE_MAX_PROPOSALS_PER_WEEK=1
IN_SEASON_TRADE_COOLDOWN_DAYS=7
IN_SEASON_TRADE_EXPIRATION_HOURS=24
IN_SEASON_ACQUISITION_MIN_CONFIDENCE=0.80
IN_SEASON_ACQUISITION_EXPIRE_MINUTES_BEFORE_KICKOFF=10
IN_SEASON_WAIVER_EXPIRE_MINUTES_BEFORE_PROCESSING=5
WAIVER_SEMANTICS_CONFIRMED=false
WAIVER_MODE=rolling_priority
WAIVER_PROCESS_WEEKDAY=2
WAIVER_PROCESS_HOUR=1
WAIVER_DROP_CLEAR_DAYS=2
CODEX_DECISIONS_DIR=/app/codex-decisions
CODEX_DECISIONS_HOST_DIR="/Volumes/Extreme SSD/FantasyFootballManager/runtime/codex-decisions"
CODEX_DECISION_POLL_MS=500
CODEX_WORKER_HEARTBEAT_MS=10000
# Independent LaunchAgent restarts an alive-but-stalled worker after five minutes.
CODEX_WORKER_STALE_SECONDS=300
CODEX_WATCHDOG_PATH=/app/host-runtime/codex-watchdog.json
REPORTS_DIR=/app/reports
APP_SECRET_KEY=replace-with-a-long-random-value
SHIM_SHARED_SECRET=replace-with-a-different-long-random-value
EXECUTION_MODE=dry_run
DASHBOARD_PUBLIC_URL=http://fantasy-manager.local:3000
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3000
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# One-way Slack Incoming Webhook. The URL can post only to its configured channel.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_LABEL=sleeper-ai-alerts
SLACK_DAILY_ALERT_LIMIT=20
# Optional dedicated text destination for trash talk. When omitted, the operational
# webhook above remains the backward-compatible fallback.
TRASH_TALK_SLACK_WEBHOOK_URL=
TRASH_TALK_SLACK_CHANNEL_LABEL=fantasy-football-trash-talk
# Optional, narrowly scoped image delivery. Invite the bot to the trash-talk channel
# and grant files:write. Text-only trash talk uses its dedicated incoming webhook.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Entertainment is fail-closed and separately rate-limited from operational alerts.
TRASH_TALK_ENABLED=false
TRASH_TALK_AUTO_POST=true
TRASH_TALK_WEEKLY_TARGET=6
TRASH_TALK_WEEKLY_LIMIT=10
TRASH_TALK_DAILY_LIMIT=4
TRASH_TALK_COOLDOWN_MINUTES=90
TRASH_TALK_MODEL_TIMEOUT_SECONDS=60
NWS_BASE_URL=https://api.weather.gov
NWS_USER_AGENT=JimAiFantasy/1.0
CODEX_EXPLANATIONS_ENABLED=false
CODEX_BIN=/usr/local/bin/codex
FANTASY_ROOT="/Volumes/Extreme SSD/FantasyFootballManager"
FANTASY_PROJECT_DIR="/Volumes/Extreme SSD/FantasyFootballManager/source"
FANTASY_RUNTIME_HOST_DIR="/Volumes/Extreme SSD/FantasyFootballManager/runtime"
FANTASY_RUNTIME_VOLUME_MOUNT=/Volumes/FantasyFootballRuntime
FANTASY_STORAGE_HEALTH_PATH="/Volumes/Extreme SSD/FantasyFootballManager"
REPORTS_HOST_DIR="/Volumes/Extreme SSD/FantasyFootballManager/runtime/reports"
BACKUP_DIR="/Volumes/Extreme SSD/FantasyFootballManager/backups"
MIN_FREE_DISK_GB=40
FANTASY_API_URL=http://127.0.0.1:8000
FANTASY_AGENT_ID=playwright-agent-primary
AGENT_POLL_SECONDS=2
SLEEPER_ACCOUNT_LABEL=jimkardos
SLEEPER_TEAM_LABEL=Jim.ai
BROWSER_CHANNEL=chrome
BROWSER_CDP_URL=http://127.0.0.1:9227/
BROWSER_APPLICATION="Google Chrome"
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR="/Volumes/Extreme SSD/FantasyFootballManager/runtime/browser-profile"
SLEEPER_UI_CONTRACT_VERSION=sleeper-web-2026-09-09.4
# DRAFT_PLAYER has been qualified for this league's snake draft flow. Enable it
# together with EXECUTION_MODE=browser and DRAFT_AUTO_PICK_ENABLED=true.
# One WAIVER_CLAIM has a qualified selector, submission, and authenticated verifier.
# Fallback claims, pending edits, immediate adds, and IR require separate qualification.
BROWSER_LIVE_ACTIONS=
SOURCE_GATING_V2_ENABLED=true
# These three capabilities collect and display versioned shadow evidence first.
USAGE_FEATURES_ENABLED=true
PROJECTION_ENSEMBLE_ENABLED=true
CHAMPIONSHIP_SIMULATION_ENABLED=true
# Promote the new evidence into authoritative Codex decisions only after shadow qualification.
IN_SEASON_PLAN_V2_ENABLED=false
IN_SEASON_PLAN_V2_EXECUTION_ENABLED=false
